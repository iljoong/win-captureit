<Window x:Class="CaptureIt.App.Overlays.MonitorPickerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        WindowStartupLocation="Manual">
    <Grid>
        <Image x:Name="FrozenDesktopImage" Stretch="Fill" />
        <Canvas x:Name="MonitorOverlaysCanvas" />
        <TextBlock Text="Click a monitor (or press its number) to capture it full-screen. Esc to cancel."
                   Foreground="White" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   Background="#66000000" Padding="8,4" />
    </Grid>
</Window>
