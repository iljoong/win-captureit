<Window x:Class="CaptureIt.App.Overlays.AiAnswerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="760" Height="520">
    <Border CornerRadius="12" Padding="20">
        <Border.Background>
            <SolidColorBrush x:Name="PanelBackgroundBrush" Color="#1E1E1E" Opacity="0.93" />
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AI answer" FontSize="18" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,12" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="AnswerText"
                           Text="Thinking…"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="#EEEEEE" />
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Opacity" Foreground="#AAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="OpacitySlider" Width="120" VerticalAlignment="Center"
                            Minimum="0.2" Maximum="1.0"
                            SmallChange="0.05" LargeChange="0.1"
                            IsSnapToTickEnabled="True" TickFrequency="0.05"
                            ValueChanged="OnOpacityChanged" />
                </StackPanel>
                <TextBlock Text="Press Enter or Esc to close"
                           Foreground="#AAAAAA" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
