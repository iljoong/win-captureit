<Window x:Class="CaptureIt.App.Overlays.RegionSelectOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Cross"
        WindowStartupLocation="Manual">
    <Grid>
        <!-- The frozen full-desktop image, shown 1:1 so the overlay never needs a
             fresh (and racy) live capture. -->
        <Image x:Name="FrozenDesktopImage" Stretch="Fill" />

        <!-- Dimming layer over the whole frozen image. -->
        <Rectangle Fill="#88000000" IsHitTestVisible="False" />

        <!-- The user's in-progress selection is drawn brighter (not dimmed) by
             punching through via a second, undimmed copy of the image clipped to
             the selection rectangle. -->
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRectangle"
                       Stroke="#FF00A8FF" StrokeThickness="2"
                       Fill="Transparent"
                       Visibility="Collapsed" />
        </Canvas>

        <TextBlock x:Name="HintText"
                   Text="Drag to select a region. Enter/release to confirm, Esc to cancel."
                   Foreground="White" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   Background="#66000000" Padding="8,4" />
    </Grid>
</Window>
