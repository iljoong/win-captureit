<Window x:Class="CaptureIt.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaptureIt Settings" Width="560" Height="760"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="Save" Width="90" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Save Option -->
                <GroupBox Header="Save Option" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <TextBlock Text="Save folder:" Margin="0,0,0,2" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse..." Width="90" Margin="8,0,0,0" Click="OnBrowseFolderClick" />
                            <TextBox x:Name="SaveFolderTextBox" VerticalContentAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="File name pattern (.png always appended):" Margin="0,12,0,2" />
                        <TextBox x:Name="FilenamePatternTextBox" TextChanged="OnFilenamePatternTextChanged" />
                        <TextBlock x:Name="FilenamePreviewText" Margin="0,6,0,0" Foreground="Gray" />
                        <TextBlock Text="Tokens: {date}, {time}, {datetime}" Margin="0,2,0,0" FontSize="11" Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <!-- Capture Options -->
                <GroupBox Header="Capture Options" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <TextBlock Text="Global hotkey (repeats last-used capture mode):" Margin="0,0,0,2" />
                        <TextBox x:Name="HotkeyTextBox" IsReadOnly="True"
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown"
                                 Text="Click here and press a new key combination" />
                        <TextBlock x:Name="HotkeyValidationText" Margin="0,6,0,0" Foreground="Red" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Capture delay:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CaptureDelayComboBox" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Saving option:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="SavingOptionComboBox" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Text Extract Options -->
                <GroupBox Header="Text Extract Options" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="OcrEnabledCheckBox" Content="Extract text from captured screenshots"
                                  Checked="OnOcrEnabledChanged" Unchecked="OnOcrEnabledChanged" />

                        <StackPanel x:Name="TextExtractOptionsPanel" Margin="0,10,0,0">
                            <ComboBox x:Name="ExtractMethodComboBox" Width="220" HorizontalAlignment="Left" />

                            <TextBlock Text="Base URL:" Margin="0,10,0,2" />
                            <TextBox x:Name="AiBaseUrlTextBox" />

                            <TextBlock Text="Model:" Margin="0,10,0,2" />
                            <TextBox x:Name="AiModelTextBox" />

                            <TextBlock Text="API Key:" Margin="0,10,0,2" />
                            <PasswordBox x:Name="AiApiKeyBox" />
                            <TextBlock x:Name="AiApiKeyHintText" Margin="0,2,0,0" FontSize="11" Foreground="Gray" />

                            <TextBlock Text="Prompt (used by &quot;Use AI to answer&quot;):" Margin="0,10,0,2" />
                            <TextBox x:Name="AiPromptTextBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <DockPanel Margin="0,12,0,4">
                                <Button DockPanel.Dock="Right" x:Name="McpAddButton" Content="&#xE710;"
                                        FontFamily="Segoe MDL2 Assets" Width="28" ToolTip="Add MCP server" Click="OnMcpAddClick" />
                                <TextBlock Text="MCP servers (tools for &quot;Use AI to answer&quot;):" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel x:Name="McpServersPanel" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Notes -->
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12"
                           Text="Note: CaptureIt does not start automatically with Windows. Screenshots are saved as PNG only. If the save folder becomes unavailable, captures automatically fall back to the Pictures\CaptureIt folder. The AI capture API key is stored securely in Windows Credential Manager, not in settings.json." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

